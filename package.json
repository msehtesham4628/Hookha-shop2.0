{
  "name": "fumare-hookah",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite",
    "dev:server": "tsx src/server/standalone.ts",
    "build": "node scripts/prepare-whm-build.mjs && node scripts/patch-home-brand-images.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "node scripts/prepare-whm-build.mjs && node scripts/patch-home-brand-images.mjs && vite build",
    "build:server": "node scripts/prepare-whm-build.mjs && node scripts/patch-home-brand-images.mjs && esbuild src/server/standalone.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/api-server.cjs",
    "start": "node dist/server.cjs",
    "start:server": "node dist/api-server.cjs",
    "seed": "tsx src/server/scripts/seed.ts",
    "sync:whm": "tsx src/server/scripts/sync-worldhookahmarket.ts",
    "create-admin": "tsx src/server/scripts/create-admin.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.0",
    "canvas-confetti": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^10.4.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
