rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ehtesham4628@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('^.*@worldhookahmarket\\.com$'))
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.firstName is string && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() <= 100 &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'MANAGER', 'PRODUCT_MANAGER', 'ORDER_MANAGER', 'CUSTOMER_SUPPORT', 'MARKETING', 'INVENTORY_MANAGER', 'CONTENT_MANAGER', 'STAFF', 'CUSTOMER'] &&
             data.status in ['ACTIVE', 'SUSPENDED', 'PENDING'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024)) &&
             (!('isWholesaleCustomer' in data) || data.isWholesaleCustomer is bool) &&
             (!('wholesaleCompany' in data) || (data.wholesaleCompany is string && data.wholesaleCompany.size() <= 200)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 1000)) &&
             (!('addressDetails' in data) || data.addressDetails is map);
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.stock is number && data.stock >= 0 &&
             data.isActive is bool &&
             (!('salePrice' in data) || (data.salePrice is number && data.salePrice >= 0)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000));
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 64 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.customerEmail is string && data.customerEmail.size() <= 256 &&
             data.total is number && data.total >= 0 &&
             data.orderStatus in ['PLACED', 'PAYMENT_CONFIRMED', 'PROCESSING', 'PACKED', 'SHIPPED', 'DELIVERED', 'CANCELLED', 'REFUNDED'] &&
             data.paymentStatus in ['PENDING', 'PAID', 'FAILED', 'REFUNDED'] &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    function isValidReview(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 3000 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'HIDDEN'];
    }

    function isValidWholesale(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200 &&
             data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 100 &&
             data.email is string && data.email.size() <= 256 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.businessType in ['LOUNGE', 'RETAIL_STORE', 'DISTRIBUTOR', 'ONLINE_STORE', 'OTHER'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    function isValidWishlist(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.productIds is list && data.productIds.size() <= 500;
    }

    // --- Match Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      // Customer registration: role must be CUSTOMER unless admin
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'CUSTOMER' || isAdmin()
      );
      
      // Customer profile updates: cannot alter role or status directly unless admin
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'phone', 'avatarUrl', 'wholesaleCompany', 'address', 'addressDetails', 'updatedAt'])) ||
        isAdmin()
      );
      
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Admins Directory
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Products Catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
    }

    // 4. Categories & Brands
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isValidId(categoryId) && isAdmin();
    }

    match /brands/{brandId} {
      allow read: if isValidId(brandId);
      allow write: if isValidId(brandId) && isAdmin();
    }

    // 5. Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)
      );
      
      // Secure list: users can only query orders where userId == request.auth.uid
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      
      // Only admins or automated webhook can alter order lifecycle status
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']))
      );
      
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 6. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId) && (existing().status == 'APPROVED' || isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || resource.data.status == 'APPROVED';
      
      allow create: if isValidId(reviewId) && isVerifiedUser() && isValidReview(incoming()) && incoming().userId == request.auth.uid && incoming().status == 'PENDING';
      
      allow update: if isValidId(reviewId) && (
        isAdmin() ||
        (isOwner(existing().userId) && isValidReview(incoming()) && incoming().status == 'PENDING' && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'title', 'comment']))
      );
      
      allow delete: if isValidId(reviewId) && (isAdmin() || isOwner(existing().userId));
    }

    // 7. Coupons Collection
    match /coupons/{couponId} {
      allow read: if isValidId(couponId) && (existing().isActive == true || isAdmin());
      allow list: if isAdmin() || resource.data.isActive == true;
      allow write: if isValidId(couponId) && isAdmin();
    }

    // 8. Wholesale Applications
    match /wholesaleApplications/{appId} {
      allow get: if isValidId(appId) && (isAdmin() || (isSignedIn() && existing().email == request.auth.token.email));
      allow list: if isAdmin();
      allow create: if isValidId(appId) && isValidWholesale(incoming()) && incoming().status == 'PENDING';
      allow update, delete: if isValidId(appId) && isAdmin();
    }

    // 9. Wishlists Collection
    match /wishlists/{userId} {
      allow get, list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidWishlist(incoming());
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // 10. Store Settings
    match /storeSettings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
